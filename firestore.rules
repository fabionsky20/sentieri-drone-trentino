// Regole di sicurezza di Firestore per "Quota 120".
// Vanno copiate nella console Firebase: Firestore Database → Regole → Pubblica.
// Questo file nel repo è la copia di riferimento (nessun dato personale).
//
// Struttura:
// - users/{uid}                     profilo privato (nome, zona, avatar, scadenze, cercabile)
//   ├ saved/{trail}                 sentieri salvati ("I miei")
//   ├ droni/{id}                    hangar
//   ├ bacheche/{board}              indice delle bacheche dell'utente (lo scrive solo lui)
//   ├ notifiche/{id}                notifiche in app: le scrivono gli altri membri, le legge solo lui
//   ├ uscite/{id}                   sentieri fatti (data, con chi, commento, drone sì/no, km/D+ GPX)
//   ├ note/{trail}                  note personali sui sentieri
//   └ amici/{uid}                   amici entrati con il mio link (li scrive l'invitato, li leggo io)
// - profili/{uid}                   rubrica pubblica (solo nome e foto) per la ricerca degli amici
// - codiciInvito/{codice}           link "Invita amici": chi invita (uid e nome), leggibile col codice
// - boards/{board}                  bacheca: nome, copertina, proprietario
//   ├ partecipanti/{uid}            ruolo: owner | editor (può modificare) | viewer (può solo vedere)
//   ├ sentieri/{trail}              aggiunto da, quando, data prevista, "ci sto" dei membri
//   ├ note/{id}                     note di bacheca su un sentiero
//   └ links/{token}                 inviti via link: scadenza, revoca
// - inviti/{board}_{uid}            inviti diretti (ricerca per nome)
// - condivisi, membri, utenti/…     dati storici prima delle bacheche (sola migrazione)
//
// Si entra in una bacheca SOLO con un link valido (non scaduto, non revocato) o un invito
// diretto valido: nessuno può aggiungersi da solo. Senza essere partecipante non si legge nulla.
//
// REGOLA FISSA DEL PROGETTO: nessun campo per la quota di volo dell'utente, né log di volo.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- funzioni generali

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isLegacyMember() {
      return signedIn() && exists(/databases/$(database)/documents/membri/$(request.auth.uid));
    }

    // Id dei sentieri SAT: E310, O207, E102A, E396-b …
    function validTrail(id) {
      return id is string && id.matches('^[EO][0-9]{3}[A-Z]?(-[a-z])?$');
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function optStr(v, max) {
      return v == null || str(v, 0, max);
    }

    // Data AAAA-MM-GG dal 2000 a 10 anni nel futuro, oppure null
    function optDate(v) {
      return v == null || (
        v is string
        && v.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && int(v.split('-')[0]) <= request.time.year() + 10
      );
    }

    // ---------------------------------------------------------------- bacheche: ruoli

    function boardPath(b) {
      return /databases/$(database)/documents/boards/$(b);
    }

    function partPath(b, u) {
      return /databases/$(database)/documents/boards/$(b)/partecipanti/$(u);
    }

    function isMember(b) {
      return signedIn() && exists(partPath(b, request.auth.uid));
    }

    function role(b) {
      return get(partPath(b, request.auth.uid)).data.ruolo;
    }

    // Ruolo dopo la scrittura (per le operazioni in blocco, es. creazione + migrazione)
    function roleAfter(b) {
      return getAfter(partPath(b, request.auth.uid)).data.ruolo;
    }

    function canEdit(b) {
      return isMember(b) && role(b) in ['owner', 'editor'];
    }

    function isBoardOwner(b) {
      return isMember(b) && role(b) == 'owner';
    }

    function linkOk(b, token, ruolo) {
      let l = get(/databases/$(database)/documents/boards/$(b)/links/$(token));
      return l != null
        && l.data.revocato == false
        && l.data.scade > request.time
        && l.data.ruolo == ruolo;
    }

    function inviteOk(b, u, ruolo) {
      let i = get(/databases/$(database)/documents/inviti/$(b + '_' + u));
      return i != null
        && i.data.bacheca == b
        && i.data.scade > request.time
        && i.data.ruolo == ruolo;
    }

    // ---------------------------------------------------------------- profilo privato

    function validProfile(d) {
      return d.keys().hasAll(['nome', 'onboarding', 'migrato', 'creato', 'aggiornato'])
        && d.keys().hasOnly(['nome', 'zona', 'avatar', 'onboarding', 'migrato', 'cercabile',
                             'attestato_scadenza', 'dflight_scadenza', 'invito_codice',
                             'invitato_da', 'invitato_da_nome', 'creato', 'aggiornato'])
        && str(d.nome, 1, 60)
        && optStr(d.get('zona', null), 80)
        && optStr(d.get('avatar', null), 600)
        && d.onboarding is bool
        && d.migrato is bool
        && d.get('cercabile', true) is bool
        && optDate(d.get('attestato_scadenza', null))
        && optDate(d.get('dflight_scadenza', null))
        && optStr(d.get('invito_codice', null), 40)
        && optStr(d.get('invitato_da', null), 128)
        && optStr(d.get('invitato_da_nome', null), 60)
        && d.aggiornato == request.time;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.creato == request.time;
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.creato == resource.data.creato
        // chi mi ha invitato si fissa alla creazione del profilo
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['invitato_da', 'invitato_da_nome']);

      match /saved/{trail} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validTrail(trail)
          && request.resource.data.keys().hasOnly(['aggiunto'])
          && request.resource.data.aggiunto == request.time;
      }

      match /droni/{drone} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && drone.size() <= 40
          && request.resource.data.keys().hasAll(['modello', 'classe', 'peso_g', 'aggiornato'])
          && request.resource.data.keys().hasOnly(['modello', 'classe', 'peso_g',
                                                   'assicurazione_scadenza', 'aggiornato'])
          && str(request.resource.data.modello, 1, 60)
          && request.resource.data.classe in ['C0', 'C1', 'C2', 'legacy']
          && request.resource.data.peso_g is int
          && request.resource.data.peso_g >= 1
          && request.resource.data.peso_g <= 25000
          && optDate(request.resource.data.get('assicurazione_scadenza', null))
          && request.resource.data.aggiornato == request.time;
      }

      // Indice personale delle bacheche (per elencarle senza query tra bacheche altrui).
      match /bacheche/{board} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['aggiunta'])
          && request.resource.data.aggiunta == request.time;
      }

      // Notifiche in app. Le crea chi compie l'azione, solo verso chi condivide con lui una
      // bacheca (o verso chi il proprietario sta invitando). Il destinatario le legge e le segna.
      match /notifiche/{n} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letta'])
          && request.resource.data.letta == true;
        allow create: if signedIn()
          && uid != request.auth.uid
          && validNotif(request.resource.data)
          && notifRelated(uid, request.resource.data);
      }

      // Uscite ("segna come fatto"): solo del proprietario. Data, con chi, commento, se c'era
      // il drone, km e dislivello a piedi da GPX. REGOLA FISSA: nessun campo di quota/volo
      // (hasOnly rifiuta qualunque altro campo).
      match /uscite/{o} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && o.size() <= 40
          && validOuting(request.resource.data)
          && request.resource.data.creato == request.time;
        allow update: if isOwner(uid)
          && validOuting(request.resource.data)
          && request.resource.data.creato == resource.data.creato;
      }

      // Note personali sul sentiero: solo del proprietario.
      match /note/{trail} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validTrail(trail)
          && request.resource.data.keys().hasOnly(['testo', 'aggiornato'])
          && str(request.resource.data.testo, 1, 2000)
          && request.resource.data.aggiornato == request.time;
      }

      // Amici entrati con il mio link. Li crea l'invitato, una volta sola, mentre crea il proprio
      // profilo, e solo conoscendo il mio codice. Li leggo io; ognuno può togliere la propria voce.
      match /amici/{f} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid) || isOwner(f);
        allow create: if isOwner(f)
          && f != uid
          && request.resource.data.keys().hasOnly(['nome', 'avatar', 'codice', 'entrato'])
          && request.resource.data.keys().hasAll(['nome', 'codice', 'entrato'])
          && str(request.resource.data.nome, 1, 60)
          && optStr(request.resource.data.get('avatar', null), 600)
          && str(request.resource.data.codice, 12, 40)
          && get(/databases/$(database)/documents/codiciInvito/$(request.resource.data.codice)).data.uid == uid
          && !exists(/databases/$(database)/documents/users/$(f))
          && getAfter(/databases/$(database)/documents/users/$(f)).data.get('invitato_da', null) == uid
          && request.resource.data.entrato == request.time;
      }
    }

    // ---------------------------------------------------------------- invita amici

    // Il codice è lungo e casuale: chi ha il link legge solo nome e uid di chi invita
    // (anche senza login, per mostrare "Fabio ti ha invitato"). Nessun elenco.
    match /codiciInvito/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && code.size() >= 12 && code.size() <= 40
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'creato'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.nome, 1, 60)
        && request.resource.data.creato == request.time;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome'])
        && str(request.resource.data.nome, 1, 60);
      allow delete: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
    }

    // Data dell'uscita: AAAA-MM-GG reale, dal 1980 a fine anno prossimo.
    function outingDate(v) {
      return v is string
        && v.matches('^(19[89][0-9]|20[0-9]{2})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && int(v.split('-')[0]) <= request.time.year() + 1;
    }

    function validOuting(d) {
      return d.keys().hasAll(['sentiero', 'data', 'con', 'conUid', 'drone', 'creato', 'aggiornato'])
        && d.keys().hasOnly(['sentiero', 'data', 'con', 'conUid', 'commento', 'drone',
                             'gpx_km', 'gpx_dplus', 'parziale', 'partenza', 'fino_m', 'ar',
                             'creato', 'aggiornato'])
        // Uscita parziale ("fin dove sono arrivato"): capo di partenza e metri fatti da lì.
        // Senza questi campi (uscite già salvate) l'uscita è completa, solo andata.
        && d.get('parziale', false) is bool
        && d.get('ar', false) is bool
        && (d.get('partenza', null) == null || d.partenza in ['inizio', 'fine'])
        && (d.get('fino_m', null) == null || (d.fino_m is int && d.fino_m >= 0 && d.fino_m <= 200000))
        && (d.get('parziale', false) == false
            || (d.get('partenza', null) != null && d.get('fino_m', null) != null))
        && validTrail(d.sentiero)
        && outingDate(d.data)
        && d.con is list && d.con.size() <= 20
        && d.conUid is list && d.conUid.size() <= 20
        && optStr(d.get('commento', null), 500)
        && d.drone is bool
        && (d.get('gpx_km', null) == null
            || (d.gpx_km is number && d.gpx_km >= 0 && d.gpx_km <= 300))
        && (d.get('gpx_dplus', null) == null
            || (d.gpx_dplus is int && d.gpx_dplus >= 0 && d.gpx_dplus <= 15000))
        && d.aggiornato == request.time;
    }

    function validNotif(d) {
      return d.keys().hasAll(['tipo', 'bacheca', 'bachecaNome', 'da', 'daNome', 'creato', 'letta'])
        && d.keys().hasOnly(['tipo', 'bacheca', 'bachecaNome', 'sentiero', 'da', 'daNome', 'testo', 'creato', 'letta'])
        && d.tipo in ['invito', 'accettato', 'sentiero', 'cisto', 'nota']
        && str(d.bacheca, 1, 40)
        && str(d.bachecaNome, 1, 60)
        && (d.get('sentiero', null) == null || validTrail(d.sentiero))
        && d.da == request.auth.uid
        && str(d.daNome, 1, 60)
        && optStr(d.get('testo', null), 200)
        && d.creato == request.time
        && d.letta == false;
    }

    function notifRelated(uid, d) {
      return (d.tipo == 'invito'
              && existsAfter(/databases/$(database)/documents/inviti/$(d.bacheca + '_' + uid))
              && roleAfter(d.bacheca) == 'owner')
        || (d.tipo != 'invito'
              && existsAfter(partPath(d.bacheca, request.auth.uid))
              && exists(partPath(d.bacheca, uid)));
    }

    // ---------------------------------------------------------------- rubrica pubblica

    // Solo nome e foto di chi ha scelto di essere trovato; ricerca limitata a 20 risultati.
    match /profili/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['nome', 'nomeMin', 'avatar', 'aggiornato'])
        && str(request.resource.data.nome, 1, 60)
        && request.resource.data.nomeMin == request.resource.data.nome.lower()
        && optStr(request.resource.data.get('avatar', null), 600)
        && request.resource.data.aggiornato == request.time;
      allow delete: if isOwner(uid);
    }

    // ---------------------------------------------------------------- bacheche

    function validBoard(d) {
      return d.keys().hasOnly(['nome', 'copertina', 'owner', 'creato', 'aggiornato'])
        && str(d.nome, 1, 60)
        && d.copertina is map
        && d.copertina.keys().hasOnly(['tipo', 'valore'])
        && d.copertina.tipo in ['colore', 'sentiero']
        && str(d.copertina.valore, 1, 20)
        && d.aggiornato == request.time;
    }

    match /boards/{b} {
      allow get: if isMember(b);
      allow list: if false;
      allow create: if signedIn()
        && validBoard(request.resource.data)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.creato == request.time
        && existsAfter(partPath(b, request.auth.uid))
        && (b != 'condivisi' || isLegacyMember());
      allow update: if isBoardOwner(b)
        && validBoard(request.resource.data)
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.creato == resource.data.creato;
      allow delete: if isBoardOwner(b);

      // ---- partecipanti

      function validPart(d, u) {
        return d.keys().hasOnly(['uid', 'ruolo', 'nome', 'avatar', 'via', 'token', 'entrato'])
          && d.keys().hasAll(['uid', 'ruolo', 'nome', 'via', 'entrato'])
          && d.uid == u
          && d.ruolo in ['owner', 'editor', 'viewer']
          && str(d.nome, 1, 60)
          && optStr(d.get('avatar', null), 600)
          && d.via in ['creazione', 'link', 'invito', 'migrazione']
          && (d.ruolo == 'owner') == (d.via == 'creazione')
          && optStr(d.get('token', null), 64)
          && d.entrato == request.time;
      }

      match /partecipanti/{u} {
        allow read: if isMember(b) || isOwner(u);
        allow create: if signedIn()
          && validPart(request.resource.data, u)
          && !exists(partPath(b, u))
          && (
            // il creatore, insieme alla bacheca
            (u == request.auth.uid && request.resource.data.via == 'creazione'
              && !exists(boardPath(b))
              && getAfter(boardPath(b)).data.owner == request.auth.uid)
            // con un link valido
            || (u == request.auth.uid && request.resource.data.via == 'link'
              && linkOk(b, request.resource.data.token, request.resource.data.ruolo))
            // con un invito diretto valido
            || (u == request.auth.uid && request.resource.data.via == 'invito'
              && inviteOk(b, u, request.resource.data.ruolo))
            // migrazione della lista storica: il proprietario aggiunge i membri storici
            || (b == 'condivisi' && u != request.auth.uid && request.resource.data.via == 'migrazione'
              && request.resource.data.ruolo == 'editor'
              && roleAfter(b) == 'owner'
              && exists(/databases/$(database)/documents/membri/$(u)))
          );
        // Il proprietario cambia il ruolo degli altri (mai in proprietario).
        allow update: if isBoardOwner(b)
          && u != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ruolo'])
          && request.resource.data.ruolo in ['editor', 'viewer'];
        // Un membro esce; il proprietario toglie gli altri; il proprietario esce solo
        // eliminando la bacheca nella stessa operazione.
        allow delete: if (isOwner(u) && role(b) != 'owner')
          || (isBoardOwner(b) && u != request.auth.uid)
          || (isOwner(u) && !existsAfter(boardPath(b)));
      }

      // ---- sentieri della bacheca

      function validItem(d) {
        return d.keys().hasOnly(['da', 'daNome', 'aggiunto', 'data', 'ciSto'])
          && d.keys().hasAll(['da', 'daNome', 'aggiunto', 'ciSto'])
          && str(d.da, 1, 128)
          && str(d.daNome, 1, 60)
          && optDate(d.get('data', null))
          && d.ciSto is map;
      }

      match /sentieri/{t} {
        allow read: if isMember(b);
        allow create: if validTrail(t)
          && validItem(request.resource.data)
          && request.resource.data.aggiunto == request.time
          && request.resource.data.ciSto.size() == 0
          && (
            (canEdit(b) && request.resource.data.da == request.auth.uid)
            // migrazione: il proprietario riporta chi aveva aggiunto il sentiero
            || (b == 'condivisi' && roleAfter(b) == 'owner'
              && existsAfter(partPath(b, request.resource.data.da)))
          );
        allow update: if canEdit(b)
          && validItem(request.resource.data)
          && (
            // data prevista
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data'])
            // "ci sto": ognuno solo il proprio
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ciSto'])
              && request.resource.data.ciSto.diff(resource.data.ciSto).affectedKeys().hasOnly([request.auth.uid])
              && request.resource.data.ciSto.get(request.auth.uid, true) == true)
          );
        allow delete: if canEdit(b);
      }

      // ---- note di bacheca

      match /note/{n} {
        allow read: if isMember(b);
        allow create: if canEdit(b)
          && request.resource.data.keys().hasOnly(['sentiero', 'testo', 'autore', 'autoreNome', 'creato'])
          && validTrail(request.resource.data.sentiero)
          && str(request.resource.data.testo, 1, 1000)
          && request.resource.data.autore == request.auth.uid
          && str(request.resource.data.autoreNome, 1, 60)
          && request.resource.data.creato == request.time;
        allow delete: if signedIn()
          && (resource.data.autore == request.auth.uid || isBoardOwner(b));
      }

      // ---- inviti via link (il token è l'id, casuale e lungo)

      match /links/{token} {
        // Chi ha il link legge solo l'invito (nome bacheca, chi invita, ruolo, scadenza).
        allow get: if signedIn();
        allow list: if isBoardOwner(b);
        allow create: if isBoardOwner(b)
          && token.size() >= 20 && token.size() <= 64
          && request.resource.data.keys().hasOnly(['ruolo', 'scade', 'revocato', 'da', 'daNome', 'bachecaNome', 'creato'])
          && request.resource.data.ruolo in ['editor', 'viewer']
          && request.resource.data.scade is timestamp
          && request.resource.data.scade > request.time
          && request.resource.data.scade < request.time + duration.value(31, 'd')
          && request.resource.data.revocato == false
          && request.resource.data.da == request.auth.uid
          && str(request.resource.data.daNome, 1, 60)
          && str(request.resource.data.bachecaNome, 1, 60)
          && request.resource.data.creato == request.time;
        allow update: if isBoardOwner(b)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revocato'])
          && request.resource.data.revocato == true;
        allow delete: if isBoardOwner(b);
      }
    }

    // ---------------------------------------------------------------- inviti diretti

    match /inviti/{id} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isBoardOwner(resource.data.bacheca));
      allow create: if signedIn()
        && id == request.resource.data.bacheca + '_' + request.resource.data.uid
        && request.resource.data.keys().hasOnly(['bacheca', 'uid', 'uNome', 'ruolo', 'da', 'daNome', 'bachecaNome', 'scade', 'creato'])
        && optStr(request.resource.data.get('uNome', null), 60)
        && isBoardOwner(request.resource.data.bacheca)
        && request.resource.data.uid != request.auth.uid
        && !exists(partPath(request.resource.data.bacheca, request.resource.data.uid))
        && request.resource.data.ruolo in ['editor', 'viewer']
        && request.resource.data.scade is timestamp
        && request.resource.data.scade > request.time
        && request.resource.data.scade < request.time + duration.value(31, 'd')
        && request.resource.data.da == request.auth.uid
        && str(request.resource.data.daNome, 1, 60)
        && str(request.resource.data.bachecaNome, 1, 60)
        && request.resource.data.creato == request.time;
      // L'invitato rifiuta o, dopo aver accettato, lo toglie; il proprietario lo ritira.
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid || isBoardOwner(resource.data.bacheca));
    }

    // ---------------------------------------------------------------- dati storici

    // Vecchi salvati: il proprietario li legge (migrazione) e li può cancellare.
    match /utenti/{uid}/salvati/{trail} {
      allow read, delete: if isOwner(uid);
    }

    // Elenco dei membri storici: si modifica dalla console; ciascuno può togliersi.
    match /membri/{uid} {
      allow read: if isOwner(uid) || isLegacyMember();
      allow delete: if isOwner(uid);
      allow create, update: if false;
    }

    // Lista condivisa storica: solo lettura per i membri storici (è diventata la bacheca
    // "condivisi"); cancellabile per l'eliminazione dell'account.
    match /condivisi/{trail} {
      allow read, delete: if isLegacyMember();
    }
  }
}
